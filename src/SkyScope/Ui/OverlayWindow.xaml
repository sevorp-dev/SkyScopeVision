<Window x:Class="SkyScope.Ui.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Focusable="False"
        IsHitTestVisible="False"
        Title="SkyScope Overlay">
    <Grid x:Name="Root">
        <Rectangle x:Name="DimRect" Fill="#000000" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Canvas x:Name="ScopeCanvas" IsHitTestVisible="False">
            <Ellipse x:Name="CircleBorder" Fill="Transparent" IsHitTestVisible="False"/>
            <Rectangle x:Name="SquareBorder" Fill="Transparent" RadiusX="18" RadiusY="18" IsHitTestVisible="False"/>
            <Line x:Name="LineN" IsHitTestVisible="False"/>
            <Line x:Name="LineS" IsHitTestVisible="False"/>
            <Line x:Name="LineW" IsHitTestVisible="False"/>
            <Line x:Name="LineE" IsHitTestVisible="False"/>
            <Ellipse x:Name="CenterDot" IsHitTestVisible="False"/>
            <Border x:Name="Badge" CornerRadius="11" Background="#A6101012" IsHitTestVisible="False">
                <TextBlock x:Name="BadgeText" Foreground="#FF7D1F" FontSize="13" FontWeight="SemiBold"
                           Padding="10,3" Text="2.0×"/>
            </Border>
        </Canvas>
    </Grid>
</Window>
