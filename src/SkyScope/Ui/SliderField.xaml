<UserControl x:Class="SkyScope.Ui.SliderField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource FieldRow}">
        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource FieldName}" Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <TextBlock Style="{StaticResource FieldDesc}" Text="{Binding Desc, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Slider x:Name="Slider" Style="{StaticResource SkySlider}"
                        ValueChanged="Slider_ValueChanged"/>
                <TextBlock x:Name="ValueText" Width="56" TextAlignment="Right"
                           Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
